            "Arsenal Store rất vui khi sản phẩm đã làm hài lòng quý khách. Đừng quên theo dõi các chương trình ưu đãi mới nhất nhé!",
            "Chúng tôi chân thành cảm ơn đánh giá của quý khách và sẽ cố gắng cải thiện chất lượng dịch vụ hơn nữa.",
            "Xin lỗi quý khách về sự bất tiện này, chúng tôi sẽ kiểm tra lại vấn đề và liên hệ hỗ trợ trong thời gian sớm nhất.",
            "Cửa hàng đã tiếp nhận phản hồi của quý khách và đang tiến hành xử lý. Mong quý khách thông cảm."
        ];

        const getMediaUrls = (productName) => {
            const nameLower = productName.toLowerCase();
            
            // 1. Nhóm sản phẩm TẤT (Socks)
            if (nameLower.includes('tất') || nameLower.includes('sock')) {
                return [
                    'https://picsum.photos/id/103/400/400',  // Giày thể thao kết hợp tất dệt kim cổ cao
                    'https://picsum.photos/id/291/400/400',  // Đôi chân mang giày chạy và tất ôm sát
                    'https://picsum.photos/id/355/400/400'   // Hoạt động chạy bộ ngoài trời
                ];
            }
            
            // 2. Nhóm sản phẩm DÉP (Slides)
            if (nameLower.includes('dép') || nameLower.includes('slide') || nameLower.includes('sandal')) {
                return [
                    'https://picsum.photos/id/347/400/400',  // Dép lê đi mưa / dép bơi thể thao
                    'https://picsum.photos/id/431/400/400'   // Dép lê quai ngang đi ngoài trời
                ];
            }
            
            // 3. Nhóm sản phẩm QUẦN (Shorts/Pants)
            if (nameLower.includes('quần') || nameLower.includes('short') || nameLower.includes('pant')) {
                return [
                    'https://picsum.photos/id/1077/400/400', // Mẫu mặc đồ thể thao nam / quần đùi
                    'https://picsum.photos/id/355/400/400',  // Chạy bộ mặc quần thể thao nhẹ thoáng
                    'https://picsum.photos/id/103/400/400'   // Giày thể thao phong cách kết hợp shorts
                ];
            }
            
            // 4. Mặc định: Nhóm ÁO đấu (Jerseys/Shirts)
            return [
                'https://picsum.photos/id/770/400/400',  // Sân bóng đá / sân vận động phủ cỏ xanh
                'https://picsum.photos/id/1077/400/400', // Đồ tập bóng đá chuyên nghiệp khỏe khoắn
                'https://picsum.photos/id/355/400/400'   // Vận động thể thao trên sân
            ];
        };

        for (const product of products) {
            const numReviews = Math.floor(Math.random() * 16) + 35; // Tạo từ 35 đến 50 đánh giá cho mỗi sản phẩm
            const productReviews = [];

            for (let r = 0; r < numReviews; r++) {
                const reviewer = allReviewers[Math.floor(Math.random() * allReviewers.length)];
                
                // Tỷ lệ đánh giá cao nhiều hơn (85% là 4-5 sao, 10% là 3 sao, 5% là 1-2 sao)
                const rand = Math.random();
                let rating;
                if (rand < 0.65) {
                    rating = 5; // 65% đánh giá 5 sao
                } else if (rand < 0.85) {
                    rating = 4; // 20% đánh giá 4 sao
                } else if (rand < 0.95) {
                    rating = 3; // 10% đánh giá 3 sao
                } else if (rand < 0.98) {
                    rating = 2; // 3% đánh giá 2 sao
                } else {
                    rating = 1; // 2% đánh giá 1 sao
                }
                
                const comment = getRandomComment(product.name, rating);

                // Không đính kèm ảnh mẫu tự sinh nữa theo yêu cầu của khách hàng
                const media = [];

                // Random likes/dislikes (Giới hạn chỉ dislike bình luận tiêu cực/trung lập)
                const likes = [];
                const dislikes = [];
                for (const otherUser of allReviewers) {
                    if (otherUser._id.toString() !== reviewer._id.toString()) {
                        // Likes xuất hiện nhiều hơn ở bình luận tích cực
                        const likeProb = rating >= 4 ? 0.15 : (rating >= 3 ? 0.08 : 0.02);
                        if (Math.random() < likeProb) likes.push(otherUser._id.toString());

                        // CHỈ cho phép Dislike đối với đánh giá tiêu cực (<= 2 sao) hoặc trung lập (3 sao)
                        if (rating <= 2) {
                            if (Math.random() < 0.12) dislikes.push(otherUser._id.toString());
                        } else if (rating === 3) {
                            if (Math.random() < 0.03) dislikes.push(otherUser._id.toString());
                        }
                    }
                }

                const reviewDate = new Date(Date.now() - Math.floor(Math.random() * 90) * 24 * 60 * 60 * 1000); // Trong vòng 90 ngày

                const review = {
                    id: Date.now() + r + Math.floor(Math.random() * 1000), // ID duy nhất
                    reviewerId: reviewer._id.toString(),
                    name: reviewer.name,
                    isAdmin: reviewer.isAdmin,
                    isVerifiedPurchase: Math.random() > 0.3, // 70% đã mua hàng
                    rating: rating,
                    comment: comment,
                    date: reviewDate.toISOString(),
                    likes: likes,
                    dislikes: dislikes,
                    media: media,
                    isEdited: Math.random() < 0.05, // 5% đã chỉnh sửa
                    isPinned: Math.random() < 0.02 && reviewer.isAdmin, // 2% admin ghim
                    replies: []
                };

                // Sinh replies cho review này
                const numReplies = Math.floor(Math.random() * 3); // 0 đến 2 replies
                for (let rep = 0; rep < numReplies; rep++) {
                    const replyAuthor = Math.random() < 0.7 ? existingAdmin : createdUsers[Math.floor(Math.random() * createdUsers.length)]; // 70% từ admin
                    if (replyAuthor) {
                        review.replies.push({
                            id: Date.now() + r + rep + Math.floor(Math.random() * 10000),
                            authorId: replyAuthor._id.toString(),
                            authorName: replyAuthor.name,
                            isAdmin: replyAuthor.isAdmin,
                            text: adminReplies[Math.floor(Math.random() * adminReplies.length)],
                            date: new Date(reviewDate.getTime() + Math.floor(Math.random() * 5) * 24 * 60 * 60 * 1000).toISOString(), // Sau ngày review
                            likes: [], dislikes: []
                        });
                    }
                }
                productReviews.push(review);
            }

            // Cập nhật reviews vào sản phẩm
            product.reviews = productReviews;
            await product.save();
        }
        console.log(`Đã tạo đánh giá và phản hồi giả cho ${products.length} sản phẩm.`);

        console.log('🎉 Hoàn tất việc tạo dữ liệu mẫu!');
        process.exit();
    } catch (error) {
        console.error('Lỗi khi seed data:', error);
        process.exit(1);
    }
};

